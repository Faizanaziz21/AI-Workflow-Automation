# Copy to .env and fill in. Never commit real secrets.
FF_ENV=development
POSTGRES_PASSWORD=flowforge
# 32+ random chars:  python -c "import secrets;print(secrets.token_urlsafe(48))"
FF_JWT_SECRET=change-me-to-a-long-random-string-0123456789abcdef
# KEK map (base64 32-byte keys):  python -c "import os,base64;print(base64.b64encode(os.urandom(32)).decode())"
FF_ENCRYPTION_KEYS={"v1":"ZGV2LW9ubHktZW5jcnlwdGlvbi1rZXktMzJieXRlcyE="}
FF_ACTIVE_ENCRYPTION_KEY=v1
FF_PUBLIC_BASE_URL=http://localhost:8080
FF_CORS_ORIGINS=http://localhost:8080
# Allow nodes to call private-network hosts (the sandbox) in dev; keep false in production.
FF_ALLOW_PRIVATE_NETWORK_EGRESS=true
GRAFANA_ADMIN_PASSWORD=admin
