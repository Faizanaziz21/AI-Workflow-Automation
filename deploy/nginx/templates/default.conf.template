# Rendered by the nginx image's envsubst entrypoint into /etc/nginx/conf.d/default.conf
# (replacing the stock server). Only variables defined in the container environment are substituted.
server_tokens off;
client_max_body_size 26m;
gzip on;
gzip_types application/json text/css application/javascript image/svg+xml;

# Edge rate limits per client IP (the API applies finer per-identity GCRA limits in Redis).
# Rates come from the container environment (NGINX_API_RATE / NGINX_AUTH_RATE).
limit_req_zone $binary_remote_addr zone=api:20m rate=${NGINX_API_RATE};
limit_req_zone $binary_remote_addr zone=auth:10m rate=${NGINX_AUTH_RATE};
limit_req_status 429;

# Re-resolve service names (Docker DNS) so scaled/recreated containers are picked up without an nginx reload.
resolver 127.0.0.11 valid=10s ipv6=off;
upstream api { zone upstream_api 64k; server api:8000 resolve; keepalive 64; }
upstream web { zone upstream_web 64k; server web:3000 resolve; keepalive 32; }

map $http_x_request_id $req_id { default $http_x_request_id; "" $request_id; }

log_format json escape=json '{"ts":"$time_iso8601","ip":"$remote_addr","method":"$request_method",'
  '"uri":"$uri","status":$status,"bytes":$body_bytes_sent,"rt":$request_time,"request_id":"$req_id"}';
access_log /dev/stdout json;

server {
  listen 80;
  server_name _;

  # Security headers (CSP, HSTS, nosniff, frame options) are set by the API and the web app themselves;
  # adding them here as well would duplicate them on every response.

  proxy_http_version 1.1;
  proxy_set_header Connection "";
  proxy_set_header Host $host;
  proxy_set_header X-Real-IP $remote_addr;
  proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
  proxy_set_header X-Forwarded-Proto $scheme;
  proxy_set_header X-Request-ID $req_id;

  location = /metrics { return 404; }          # scraped on the internal network only
  location /api/v1/auth/ { limit_req zone=auth burst=20 nodelay; proxy_pass http://api; }
  location /api/v1/hooks/ { limit_req zone=api burst=500 nodelay; proxy_read_timeout 60s; proxy_pass http://api; }
  location /api/ { limit_req zone=api burst=200 nodelay; proxy_pass http://api; }
  location ~ ^/(docs|redoc|openapi.json|healthz|readyz)$ { proxy_pass http://api; }
  location / { proxy_pass http://web; }
}
